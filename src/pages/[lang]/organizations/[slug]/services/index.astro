---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDrizzle } from "@database/drizzle";
import { organization } from "@database/schemas";
import { eq } from "drizzle-orm";
import { getServices } from "@/modules/services/loaders";
import { ServiceGrid } from "@/modules/services/components/lists";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";
export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const slug = Astro.params.slug!;
const db = getDrizzle();
const [org] = await db.select({ id: organization.id, name: organization.name }).from(organization).where(eq(organization.slug, slug)).limit(1);
if (!org) return Astro.redirect(`/${locale}/services`);
const t = getServiceTranslations(locale);
const data = await getServices({ organizationId: org.id }, locale, true);
---
<BaseLayout title={`${t.labels.services} — ${org.name}`} description={t.meta.description}>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"><header class="mb-10 space-y-2"><p class="text-sm text-muted-foreground">{org.name}</p><h1 class="text-4xl font-bold">{t.labels.services}</h1></header>{data.items.length ? <ServiceGrid items={data.items} locale={locale} organizationSlug={slug} /> : <p class="rounded-xl border p-10 text-center text-muted-foreground">{t.labels.noResults}</p>}</main>
</BaseLayout>
