---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getDrizzle } from "@database/drizzle";
import { organization } from "@database/schemas";
import { eq } from "drizzle-orm";
import { getServices, getServiceTags } from "@/modules/services/loaders";
import { ServiceGrid } from "@/modules/services/components/lists";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";
export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const orgSlug = Astro.params.slug!;
const tagSlug = Astro.params.tagSlug!;
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const db = getDrizzle();
const [org] = await db.select({ id: organization.id, name: organization.name, slug: organization.slug }).from(organization).where(eq(organization.slug, orgSlug)).limit(1);
if (!org) return Astro.redirect(`/${locale}/services`);
const t = getServiceTranslations(locale);
const tags = await getServiceTags(locale, org.id);
const tag = tags.find((row) => (row.translation?.slug ?? row.tag.slug) === tagSlug);
if (!tag) return Astro.redirect(`/${locale}/organizations/${orgSlug}/services`);
const data = await getServices({ organizationId: org.id, tagId: tag.tag.id, page }, locale, true);
---
<BaseLayout title={`${tag.translation?.name ?? tag.tag.slug} — ${org.name}`} description={t.meta.description}><main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"><header class="mb-10 space-y-2"><p class="text-sm text-muted-foreground">{org.name}</p><h1 class="text-4xl font-bold">{tag.translation?.name ?? tag.tag.slug}</h1></header>{data.items.length ? <ServiceGrid items={data.items} locale={locale} organizationSlug={org.slug} /> : <p class="rounded-xl border p-10 text-center text-muted-foreground">{t.labels.noResults}</p>}
    {data.totalPages > 1 && <nav class="mt-10 flex justify-center gap-2" aria-label={t.labels.page}>{page > 1 && <a class="rounded-md border px-4 py-2" href={`?page=${page - 1}`} aria-label={t.labels.previous}>{t.labels.previous}</a>}{page < data.totalPages && <a class="rounded-md border px-4 py-2" href={`?page=${page + 1}`} aria-label={t.labels.next}>{t.labels.next}</a>}</nav>}
  </main></BaseLayout>
