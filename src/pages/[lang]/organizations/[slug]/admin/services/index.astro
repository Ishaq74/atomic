---
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import OrgSidebar from "@organisms/OrgSidebar/OrgSidebar.astro";
import { requireAuth } from "@lib/auth-guards";
import { fetchOrgData, getUserOrgRole } from "@/lib/auth-data";
import { hasServicePermission, resolveServiceTenant } from "@/modules/services/permissions";
import { getServiceAdminData, getServiceAdminStats, getServiceAdminTaxonomy, getServiceModerationQueue } from "@/modules/services/admin";
import { getServiceCategories, getServiceProviders, getServiceTags } from "@/modules/services/loaders";
import { getServiceTranslations } from "@/modules/services/i18n";
import ServicesAdminPage from "@/components/services/ServicesAdminPage.astro";
import { LOCALES } from "@i18n/config";
export const prerender = false;
const result = await requireAuth(Astro);
if ("redirect" in result) return result.redirect;
const { user, locale, authT } = result;
const orgSlug = Astro.params.slug;
if (!orgSlug) return Astro.redirect(`/${locale}/auth/${authT.routes.dashboard}`);
const orgData = await fetchOrgData(Astro.request.headers, orgSlug);
if (!orgData) return Astro.redirect(`/${locale}/auth/${authT.routes.dashboard}`);
const { org, members } = orgData;
const orgRole = getUserOrgRole(members, user.id);
const tenant = resolveServiceTenant({ organizationId: org.id });
const canRead = await hasServicePermission(Astro, tenant, { service: ["read"] });
if (!canRead) return Astro.redirect(`/${locale}/organizations/${orgSlug}/members`);
const t = getServiceTranslations(locale);
const p = Astro.url.searchParams;
const page = Math.max(1, Number(p.get("page") ?? "1") || 1);
const featured = p.has("featured") ? p.get("featured") === "true" : undefined;
const mobile = p.has("mobile") ? p.get("mobile") === "true" : undefined;
const filterInput = { page, limit: 20, search: p.get("search") || undefined, status: p.get("status") || undefined, categoryId: p.get("categoryId") || undefined, tagId: p.get("tagId") || undefined, providerId: p.get("providerId") || undefined, featured, mobile, locale: p.get("locale") || undefined, sortBy: p.get("sortBy") || undefined, sortOrder: p.get("sortOrder") || undefined };
const [data, stats, categoryOptions, tagOptions, providerOptions, taxonomy, moderation] = await Promise.all([getServiceAdminData(org.id, locale, filterInput), getServiceAdminStats(org.id), getServiceCategories(locale, org.id), getServiceTags(locale, org.id), getServiceProviders(org.id), getServiceAdminTaxonomy(org.id, locale), getServiceModerationQueue(org.id)]);
const [canCreate, canUpdate, canDelete, canPublish, canModerate, canManageCategories, canManageTags] = await Promise.all([
  hasServicePermission(Astro, tenant, { service: ["create"] }),
  hasServicePermission(Astro, tenant, { service: ["update"] }),
  hasServicePermission(Astro, tenant, { service: ["delete"] }),
  hasServicePermission(Astro, tenant, { service: ["publish"] }),
  hasServicePermission(Astro, tenant, { service: ["moderate"] }),
  hasServicePermission(Astro, tenant, { serviceCategory: ["create"] }),
  hasServicePermission(Astro, tenant, { serviceTag: ["create"] }),
]);
---
<BaseLayout title={`${t.admin.title} — ${org.name}`} description={t.meta.description}><AuthLayout title={org.name}><OrgSidebar slot="sidebar" t={authT} locale={locale} org={org} orgRole={orgRole} /><main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8"><ServicesAdminPage locale={locale} title={`${t.admin.title} — ${org.name}`} items={data.items} meta={{ page: data.page, totalPages: data.totalPages }} stats={stats} filters={filterInput} baseAdminUrl={`/${locale}/organizations/${org.slug}/admin/services`} organizationId={org.id} canCreate={canCreate} canUpdate={canUpdate} canPublish={canPublish} canDelete={canDelete} canModerate={canModerate} canManageTaxonomy={canManageCategories && canManageTags} categoryOptions={categoryOptions} tagOptions={tagOptions} providerOptions={providerOptions} localeOptions={LOCALES} taxonomy={taxonomy} moderation={moderation} /></main></AuthLayout></BaseLayout>
