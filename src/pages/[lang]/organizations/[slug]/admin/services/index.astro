---
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import OrgSidebar from "@organisms/OrgSidebar/OrgSidebar.astro";
import { requireAuth } from "@/lib/auth-guards";
import { fetchOrgData, getUserOrgRole } from "@/lib/auth-data";
import { hasServicePermission, resolveServiceTenant } from "@/modules/services/permissions";
import { getServiceAdminData, getServiceAdminStats } from "@/modules/services/admin";
import { getServiceTranslations } from "@/modules/services/i18n";
import AdminServiceList from "@/components/services/AdminServiceList.astro";
import type { Locale } from "@i18n/config";
export const prerender = false;
const result = await requireAuth(Astro);
if ("redirect" in result) return result.redirect;
const { user, locale, authT } = result;
const orgSlug = Astro.params.slug;
if (!orgSlug) return Astro.redirect(`/${locale}/auth/${authT.routes.dashboard}`);
const orgData = await fetchOrgData(Astro.request.headers, orgSlug);
if (!orgData) return Astro.redirect(`/${locale}/auth/${authT.routes.dashboard}`);
const { org, members } = orgData;
const orgRole = getUserOrgRole(members, user.id);
const tenant = resolveServiceTenant({ organizationId: org.id });
const canRead = await hasServicePermission(Astro, tenant, { service: ["read"] });
if (!canRead) return Astro.redirect(`/${locale}/organizations/${orgSlug}/members`);
const t = getServiceTranslations(locale as Locale);
const p = Astro.url.searchParams;
const page = Math.max(1, Number(p.get("page") ?? "1") || 1);
const data = await getServiceAdminData(org.id, locale as Locale, { page, limit: 20, search: p.get("search") || undefined, status: p.get("status") || undefined });
const stats = await getServiceAdminStats(org.id);
const canCreate = await hasServicePermission(Astro, tenant, { service: ["create"] });
---
<BaseLayout title={`${t.admin.title} — ${org.name}`} description={t.meta.description}>
  <AuthLayout title={org.name}><OrgSidebar slot="sidebar" t={authT} locale={locale} org={org} orgRole={orgRole} />
    <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8"><AdminServiceList locale={locale as Locale} items={data.items} total={stats.total} published={stats.published} draft={stats.draft} featured={stats.featured} views={stats.views} page={data.page} totalPages={data.totalPages} baseUrl={`/${locale}/organizations/${org.slug}/admin/services`} canCreate={canCreate} /></main>
  </AuthLayout>
</BaseLayout>
