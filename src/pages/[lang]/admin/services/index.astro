---
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { requirePermission } from "@/lib/auth-guards";
import { hasServicePermission, resolveServiceTenant } from "@/modules/services/permissions";
import { getServiceAdminData, getServiceAdminStats } from "@/modules/services/admin";
import AdminServiceList from "@/components/services/AdminServiceList.astro";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";
export const prerender = false;
const result = await requirePermission(Astro, { service: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getServiceTranslations(locale);
const p = Astro.url.searchParams;
const page = Math.max(1, Number(p.get("page") ?? "1") || 1);
const data = await getServiceAdminData(null, locale, { page, limit: 20, search: p.get("search") || undefined, status: p.get("status") || undefined });
const stats = await getServiceAdminStats(null);
const tenant = resolveServiceTenant({});
const [canCreate, canUpdate, canPublish, canDelete] = await Promise.all([
  hasServicePermission(Astro, tenant, { service: ["create"] }),
  hasServicePermission(Astro, tenant, { service: ["update"] }),
  hasServicePermission(Astro, tenant, { service: ["publish"] }),
  hasServicePermission(Astro, tenant, { service: ["delete"] }),
]);
---
<BaseLayout title={t.admin.title} description={t.meta.description}>
  <AuthLayout title={t.admin.title}>
    <AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="services" />
    <main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <AdminServiceList
        locale={locale}
        items={data.items}
        total={stats.total}
        published={stats.published}
        draft={stats.draft}
        featured={stats.featured}
        views={stats.views}
        page={data.page}
        totalPages={data.totalPages}
        baseUrl={`/${locale}/admin/services`}
        organizationId={null}
        canCreate={canCreate}
        canUpdate={canUpdate}
        canPublish={canPublish}
        canDelete={canDelete}
      />
    </main>
  </AuthLayout>
</BaseLayout>
