---
import BaseLayout from "@layouts/BaseLayout.astro";
import AuthLayout from "@organisms/AuthLayout.astro";
import AdminSidebar from "@organisms/AdminSidebar/AdminSidebar.astro";
import { requirePermission } from "@/lib/auth-guards";
import { hasServicePermission, resolveServiceTenant } from "@/modules/services/permissions";
import { getServiceAdminData, getServiceAdminStats, getServiceAdminTaxonomy, getServiceModerationQueue } from "@/modules/services/admin";
import { getServiceCategories, getServiceProviders, getServiceTags } from "@/modules/services/loaders";
import ServicesAdminPage from "@/components/services/ServicesAdminPage.astro";
import { getServiceTranslations } from "@/modules/services/i18n";
import { LOCALES } from "@i18n/config";
export const prerender = false;
const result = await requirePermission(Astro, { service: ["read"] });
if ("redirect" in result) return result.redirect;
const { locale, authT } = result;
const t = getServiceTranslations(locale);
const p = Astro.url.searchParams;
const page = Math.max(1, Number(p.get("page") ?? "1") || 1);
const featured = p.has("featured") ? p.get("featured") === "true" : undefined;
const mobile = p.has("mobile") ? p.get("mobile") === "true" : undefined;
const filterInput = { page, limit: 20, search: p.get("search") || undefined, status: p.get("status") || undefined, categoryId: p.get("categoryId") || undefined, tagId: p.get("tagId") || undefined, providerId: p.get("providerId") || undefined, featured, mobile, locale: p.get("locale") || undefined, sortBy: p.get("sortBy") || undefined, sortOrder: p.get("sortOrder") || undefined };
const [data, stats, categoryOptions, tagOptions, providerOptions, taxonomy, moderation] = await Promise.all([getServiceAdminData(null, locale, filterInput), getServiceAdminStats(null), getServiceCategories(locale, null), getServiceTags(locale, null), getServiceProviders(null), getServiceAdminTaxonomy(null, locale), getServiceModerationQueue(null)]);
const tenant = resolveServiceTenant({});
const [canCreate, canUpdate, canPublish, canDelete, canModerate] = await Promise.all([hasServicePermission(Astro, tenant, { service: ["create"] }), hasServicePermission(Astro, tenant, { service: ["update"] }), hasServicePermission(Astro, tenant, { service: ["publish"] }), hasServicePermission(Astro, tenant, { service: ["delete"] }), hasServicePermission(Astro, tenant, { service: ["moderate"] })]);
---
<BaseLayout title={t.admin.title} description={t.meta.description}><AuthLayout title={t.admin.title}><AdminSidebar slot="sidebar" t={authT} locale={locale} activeItem="services" /><main class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8"><ServicesAdminPage locale={locale} title={t.admin.title} items={data.items} meta={{ page: data.page, totalPages: data.totalPages }} stats={stats} filters={filterInput} baseAdminUrl={`/${locale}/admin/services`} organizationId={null} canCreate={canCreate} canUpdate={canUpdate} canPublish={canPublish} canDelete={canDelete} canModerate={canModerate} categoryOptions={categoryOptions} tagOptions={tagOptions} providerOptions={providerOptions} localeOptions={LOCALES} taxonomy={taxonomy} moderation={moderation} /></main></AuthLayout></BaseLayout>
