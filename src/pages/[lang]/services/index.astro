---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getServices } from "@/modules/services/loaders";
import { ServiceGrid } from "@/modules/services/components/lists";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";
export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const t = getServiceTranslations(locale);
const page = Math.max(1, Number(Astro.url.searchParams.get("page") ?? "1") || 1);
const search = Astro.url.searchParams.get("search") ?? undefined;
const data = await getServices({ page, search }, locale, true);
---
<BaseLayout title={t.meta.title} description={t.meta.description}>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10 space-y-4"><h1 class="text-4xl font-bold">{t.labels.services}</h1><form class="flex max-w-2xl gap-2"><input class="h-11 flex-1 rounded-md border bg-background px-3" name="search" value={search ?? ""} placeholder={t.labels.search} /><button class="rounded-md bg-primary px-5 text-primary-foreground" type="submit">{t.labels.search}</button></form></header>
    {data.items.length ? <ServiceGrid items={data.items} locale={locale} /> : <p class="rounded-xl border p-10 text-center text-muted-foreground">{t.labels.noResults}</p>}
    {data.totalPages > 1 && <nav class="mt-10 flex justify-center gap-2" aria-label="Pagination">{page > 1 && <a class="rounded-md border px-4 py-2" href={`?page=${page - 1}${search ? `&search=${encodeURIComponent(search)}` : ""}`}>←</a>}{page < data.totalPages && <a class="rounded-md border px-4 py-2" href={`?page=${page + 1}${search ? `&search=${encodeURIComponent(search)}` : ""}`}>→</a>}</nav>}
  </main>
</BaseLayout>
