---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getServices, getServiceTags } from "@/modules/services/loaders";
import { ServiceGrid } from "@/modules/services/components/lists";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";
export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const tagSlug = Astro.params.tagSlug!;
const t = getServiceTranslations(locale);
const tags = await getServiceTags(locale, null);
const tag = tags.find((row) => (row.translation?.slug ?? row.tag.slug) === tagSlug);
if (!tag) return Astro.redirect(`/${locale}/services`);
const data = await getServices({ tagId: tag.tag.id }, locale, true);
---
<BaseLayout title={tag.translation?.name ?? tag.tag.slug} description={t.meta.description}>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"><header class="mb-10"><p class="text-sm text-muted-foreground">{t.labels.service}</p><h1 class="text-4xl font-bold">#{tag.translation?.name ?? tag.tag.slug}</h1></header>{data.items.length ? <ServiceGrid items={data.items} locale={locale} /> : <p class="rounded-xl border p-10 text-center text-muted-foreground">{t.labels.noResults}</p>}</main>
</BaseLayout>
