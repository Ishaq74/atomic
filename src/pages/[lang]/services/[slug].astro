---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getServiceBySlug } from "@/modules/services/loaders";
import { ServiceDetail } from "@/modules/services/components/single";
import { buildServiceJsonLd } from "@/modules/services/seo";
import { buildServiceUrl } from "@/modules/services/utils";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";
export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const slug = Astro.params.slug!;
const item = await getServiceBySlug(slug, locale, null);
if (!item) return Astro.redirect(`/${locale}/services`);
const categorySlug = item.categories[0]?.slug ?? null;
if (categorySlug) return Astro.redirect(buildServiceUrl(locale, null, item.translation?.slug ?? item.service.slug, categorySlug), 301);
const t = getServiceTranslations(locale);
const title = item.translation?.title ?? t.labels.service;
const description = item.translation?.excerpt ?? t.meta.description;
const jsonLd = buildServiceJsonLd({ name: title, description, slug: Astro.url.href, priceMinor: item.service.priceMinor, currency: item.service.currency, ratingAverage100: item.service.ratingAverage100, ratingCount: item.service.ratingCount });
---
<BaseLayout title={`${title} — ${t.meta.title}`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"><ServiceDetail item={item} locale={locale} /></main>
</BaseLayout>
