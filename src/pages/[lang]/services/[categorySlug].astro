---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getServices } from "@/modules/services/loaders";
import { getServiceCategories } from "@/modules/services/loaders";
import { ServiceGrid } from "@/modules/services/components/lists";
import { getServiceTranslations } from "@/modules/services/i18n";
import type { Locale } from "@i18n/config";
export const prerender = false;
const locale = (Astro.params.lang ?? "fr") as Locale;
const categorySlug = Astro.params.categorySlug!;
const t = getServiceTranslations(locale);
const categories = await getServiceCategories(locale, null);
const category = categories.find((row) => (row.translation?.slug ?? row.category.slug) === categorySlug);
if (!category) return Astro.redirect(`/${locale}/services`);
const data = await getServices({ categoryId: category.category.id }, locale, true);
---
<BaseLayout title={category.translation?.name ?? category.category.slug} description={category.translation?.description ?? t.meta.description}>
  <main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"><header class="mb-10"><p class="text-sm text-muted-foreground">{t.labels.category}</p><h1 class="text-4xl font-bold">{category.translation?.name ?? category.category.slug}</h1>{category.translation?.description && <p class="mt-3 max-w-3xl text-muted-foreground">{category.translation.description}</p>}</header>{data.items.length ? <ServiceGrid items={data.items} locale={locale} /> : <p class="rounded-xl border p-10 text-center text-muted-foreground">{t.labels.noResults}</p>}</main>
</BaseLayout>
