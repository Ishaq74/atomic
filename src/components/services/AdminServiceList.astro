---
import AdminResourceList from "@organisms/AdminResourceList.astro";
import AdminResourceStats from "@molecules/AdminResourceStats.astro";
import Button from "@atoms/button/Button.astro";
import ServiceCard from "@/modules/services/components/cards/ServiceCard.astro";
import { getServiceTranslations } from "@/modules/services/i18n";
import { formatServicePrice } from "@/modules/services/utils";
import type { Locale } from "@i18n/config";
import type { ServiceListItem } from "@/modules/services/domain";

const { locale, items, total, published, featured, views, page, totalPages, baseUrl, organizationId, canCreate, canUpdate, canPublish, canDelete } = Astro.props as {
  locale: Locale; items: ServiceListItem[]; total: number; published: number; featured: number; views: number; page: number; totalPages: number;
  baseUrl: string; organizationId: string | null; canCreate: boolean; canUpdate: boolean; canPublish: boolean; canDelete: boolean;
};
const t = getServiceTranslations(locale);
function pageHref(targetPage: number): string { const params = new URLSearchParams(Astro.url.searchParams); params.set("page", String(targetPage)); return `${baseUrl}?${params.toString()}`; }
---
<div data-service-admin-root data-organization-id={organizationId ?? ""} data-confirm-delete={t.admin.confirmDelete} data-confirm-archive={t.admin.confirmArchive} data-action-error={t.admin.actionError}>
  <AdminResourceList resourceId="service">
    <div slot="header" class="flex w-full flex-wrap items-center justify-between gap-3"><div><h1 class="text-2xl font-semibold">{t.admin.title}</h1><p class="text-sm text-muted-foreground">{total} {t.labels.services.toLowerCase()}</p></div>{canCreate && <Button href={`${baseUrl}/new`}>{t.admin.newService}</Button>}</div>
    <div slot="filters" class="grid gap-3 md:grid-cols-[minmax(0,1fr)_auto_auto]"><form class="contents" method="get"><input class="h-10 rounded-md border bg-background px-3 text-sm" name="search" placeholder={t.labels.search} value={Astro.url.searchParams.get("search") ?? ""} /><select class="h-10 rounded-md border bg-background px-3 text-sm" name="status"><option value="">{t.labels.allStatuses}</option><option value="PUBLISHED">{t.admin.status.PUBLISHED}</option><option value="DRAFT">{t.admin.status.DRAFT}</option><option value="ARCHIVED">{t.admin.status.ARCHIVED}</option></select><Button type="submit" variant="outline">{t.labels.search}</Button></form></div>
    <div slot="content" class="space-y-6">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><AdminResourceStats label={t.labels.services} value={total} /><AdminResourceStats label={t.admin.status.PUBLISHED} value={published} /><AdminResourceStats label={t.labels.featured} value={featured} /><AdminResourceStats label={t.labels.views} value={views} /></div>
      <div class="hidden overflow-x-auto rounded-xl border lg:block"><table class="w-full min-w-[1180px] text-sm"><thead class="bg-muted/40"><tr><th class="p-3 text-left">{t.admin.fields.title}</th><th class="p-3 text-left">{t.labels.provider}</th><th class="p-3 text-left">{t.admin.fields.price}</th><th class="p-3 text-left">{t.admin.fields.duration}</th><th class="p-3 text-left">{t.admin.fields.publication}</th><th class="p-3 text-left">{t.labels.views}</th><th class="p-3 text-right">{t.labels.actions}</th></tr></thead><tbody>
        {items.map((item) => <tr class="border-t align-top"><td class="p-3 font-medium"><a class="hover:underline" href={`${baseUrl}/${item.service.id}/edit`}>{item.translation?.title ?? item.service.slug}</a></td><td class="p-3">{item.provider?.name ?? "—"}</td><td class="p-3">{formatServicePrice(item.service.priceMinor, item.service.currency, locale) ?? "—"}</td><td class="p-3">{item.service.durationMinutes ?? "—"}</td><td class="p-3">{t.admin.status[item.service.status]}</td><td class="p-3">{item.service.viewCount}</td><td class="p-3"><div class="flex flex-wrap justify-end gap-2">{canUpdate && <a href={`${baseUrl}/${item.service.id}/edit`} class="rounded-md border px-2.5 py-1.5 text-xs hover:bg-muted">{t.admin.editService}</a>}{item.service.status === "DRAFT" && canPublish && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="publish" data-id={item.service.id}>{t.admin.publish}</button>}{item.service.status === "PUBLISHED" && canPublish && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="unpublish" data-id={item.service.id}>{t.admin.unpublish}</button>}{item.service.status !== "DELETED" && canUpdate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action={item.service.status === "ARCHIVED" ? "restore" : "archive"} data-id={item.service.id}>{item.service.status === "ARCHIVED" ? t.admin.restore : t.admin.archive}</button>}{canCreate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="duplicate" data-id={item.service.id}>{t.admin.duplicate}</button>}{canDelete && item.service.status !== "DELETED" && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs text-destructive" data-action="delete" data-id={item.service.id}>{t.admin.delete}</button>}</div></td></tr>)}
      </tbody></table></div>
      <div class="grid gap-4 lg:hidden">{items.map((item) => <div class="space-y-2"><ServiceCard item={item} locale={locale} variant="compact" /><div class="flex flex-wrap gap-2">{canUpdate && <a href={`${baseUrl}/${item.service.id}/edit`} class="rounded-md border px-2.5 py-1.5 text-xs">{t.admin.editService}</a>}{item.service.status === "DRAFT" && canPublish && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="publish" data-id={item.service.id}>{t.admin.publish}</button>}{item.service.status === "PUBLISHED" && canPublish && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="unpublish" data-id={item.service.id}>{t.admin.unpublish}</button>}{item.service.status !== "DELETED" && canUpdate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action={item.service.status === "ARCHIVED" ? "restore" : "archive"} data-id={item.service.id}>{item.service.status === "ARCHIVED" ? t.admin.restore : t.admin.archive}</button>}{canCreate && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs" data-action="duplicate" data-id={item.service.id}>{t.admin.duplicate}</button>}{canDelete && item.service.status !== "DELETED" && <button type="button" class="service-row-action rounded-md border px-2.5 py-1.5 text-xs text-destructive" data-action="delete" data-id={item.service.id}>{t.admin.delete}</button>}</div></div>)}</div>
    </div>
    <div slot="pagination" class="flex items-center justify-between"><span class="text-sm text-muted-foreground">{t.labels.page} {page} / {totalPages}</span><div class="flex gap-2">{page > 1 && <Button variant="outline" href={pageHref(page - 1)} aria-label={t.labels.previous}>{t.labels.previous}</Button>}{page < totalPages && <Button variant="outline" href={pageHref(page + 1)} aria-label={t.labels.next}>{t.labels.next}</Button>}</div></div>
  </AdminResourceList>
</div>
<script>
  import { actions } from "astro:actions";
  for (const root of document.querySelectorAll<HTMLElement>("[data-service-admin-root]")) {
    const organizationId = root.dataset.organizationId || null;
    const confirmDelete = root.dataset.confirmDelete ?? "";
    const confirmArchive = root.dataset.confirmArchive ?? "";
    const actionError = root.dataset.actionError ?? "";
    async function runServiceAction(id: string, action: string) {
      switch (action) {
        case "publish": return actions.publishService({ id, organizationId });
        case "unpublish": return actions.unpublishService({ id, organizationId });
        case "archive": return actions.archiveService({ id, organizationId });
        case "restore": return actions.restoreService({ id, organizationId });
        case "delete": return actions.deleteService({ id, organizationId });
        case "duplicate": return actions.duplicateService({ id, organizationId });
        default: return null;
      }
    }
    root.querySelectorAll<HTMLButtonElement>(".service-row-action").forEach((button) => button.addEventListener("click", async () => {
      const action = button.dataset.action ?? ""; const id = button.dataset.id; if (!id) return;
      const destructive = action === "delete" || action === "archive";
      if (destructive && !window.confirm(action === "delete" ? confirmDelete : confirmArchive)) return;
      button.disabled = true;
      try { const result = await runServiceAction(id, action); if (result?.error) throw new Error(result.error.message); window.location.reload(); }
      catch (error) { button.disabled = false; window.alert(error instanceof Error ? error.message : actionError); }
    }));
  }
</script>
