---
import AdminFormShell from "@organisms/AdminFormShell.astro";
import { Input } from "@atoms/input";
import { Textarea } from "@atoms/textarea";
import { Label } from "@atoms/label";
import { Checkbox } from "@atoms/checkbox";
import Button from "@atoms/button/Button.astro";
import MediaPicker from "@atoms/media-picker/MediaPicker.astro";
import ContentEditor from "@components/content/ContentEditor.astro";
import { getServiceTranslations, getServiceErrorMessage } from "@/modules/services/i18n";
import { getServiceCategories, getServiceTags } from "@/modules/services/loaders";
import type { Locale } from "@i18n/config";
import type { ServiceDetail } from "@/modules/services/domain";

const { locale, service = null, organizationId = null, baseAdminUrl = `/${locale}/admin/services` } = Astro.props as {
  locale: Locale;
  service?: ServiceDetail | null;
  organizationId?: string | null;
  baseAdminUrl?: string;
};
const t = getServiceTranslations(locale);
const translation = service?.translation;
const [categoryRows, tagRows] = await Promise.all([getServiceCategories(locale, organizationId), getServiceTags(locale, organizationId)]);
const selectedCategoryIds = new Set(service?.categories.map((item) => item.id) ?? []);
const selectedTagIds = new Set(service?.tags.map((item) => item.id) ?? []);
const focusKeyword = service?.seo?.focusKeyword ?? "";
const actionLabels = JSON.stringify({
  confirmDelete: t.admin.confirmDelete,
  confirmArchive: t.admin.confirmArchive,
  actionError: t.admin.actionError,
  restoreRevision: t.admin.restoreRevision,
  saved: t.admin.saved,
  lock: t.admin.lock,
  unlock: t.admin.unlock,
});
---
<AdminFormShell formSelector="form[data-service-form]" title={service ? t.admin.editService : t.admin.newService}>
  <div data-service-admin-root data-organization-id={organizationId ?? ""} data-service-id={service?.service.id ?? ""} data-base-admin-url={baseAdminUrl} data-action-labels={actionLabels}>
    {service && <section class="mb-6 rounded-xl border p-4"><div class="flex flex-wrap items-center justify-between gap-3"><div><p class="text-sm text-muted-foreground">{t.admin.fields.publication}</p><p class="font-medium">{t.admin.status[service.service.status]}</p></div><div class="flex flex-wrap gap-2">
      {service.service.status === "DRAFT" && <Button type="button" data-service-lifecycle="publish">{t.admin.publish}</Button>}
      {service.service.status === "PUBLISHED" && <Button type="button" variant="outline" data-service-lifecycle="unpublish">{t.admin.unpublish}</Button>}
      {service.service.status !== "ARCHIVED" && service.service.status !== "DELETED" && <Button type="button" variant="outline" data-service-lifecycle="archive">{t.admin.archive}</Button>}
      {service.service.status === "ARCHIVED" && <Button type="button" data-service-lifecycle="restore">{t.admin.restore}</Button>}
      {service.service.status !== "DELETED" && <Button type="button" variant="outline" data-service-lifecycle="duplicate">{t.admin.duplicate}</Button>}
      {service.service.status !== "DELETED" && <Button type="button" variant="outline" data-service-lifecycle="delete">{t.admin.delete}</Button>}
      <Button type="button" variant="outline" data-service-lock="lock">{t.admin.lock}</Button>
      <Button type="button" variant="outline" data-service-lock="unlock">{t.admin.unlock}</Button>
    </div></div></section>}

    <form id="service-form" data-service-form data-mode={service ? "edit" : "create"} class="space-y-6">
      <input type="hidden" name="organizationId" value={organizationId ?? ""} />
      <input type="hidden" name="locale" value={locale} />
      {service && <input type="hidden" name="id" value={service.service.id} />}
      <input type="hidden" name="coverImageId" value={service?.service.coverImageId ?? ""} />
      <input type="hidden" name="ogImageId" value={translation?.ogImageId ?? ""} />

      <section class="space-y-4"><div class="grid gap-4 md:grid-cols-2">
        <div class="space-y-1.5"><Label for="service-title">{t.admin.fields.title}</Label><Input id="service-title" name="title" required value={translation?.title ?? ""} /></div>
        <div class="space-y-1.5"><Label for="service-slug">{t.admin.fields.slug}</Label><Input id="service-slug" name="slug" required value={translation?.slug ?? ""} /></div>
      </div>
      <div class="space-y-1.5"><Label for="service-excerpt">{t.admin.fields.excerpt}</Label><Textarea id="service-excerpt" name="excerpt" rows={3} defaultValue={translation?.excerpt ?? ""} /></div>
      <ContentEditor name="content" value={translation?.content ?? ""} locale={locale} organizationId={organizationId} resolverName="services" label={t.admin.fields.content} required rows={16} /></section>

      <section class="grid gap-4 rounded-xl border p-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="space-y-1.5"><Label for="service-price">{t.admin.fields.price}</Label><Input id="service-price" name="priceMinor" type="number" min="0" step="1" value={service?.service.priceMinor ?? ""} /></div>
        <div class="space-y-1.5"><Label for="service-currency">{t.admin.fields.currency}</Label><Input id="service-currency" name="currency" maxlength="3" value={service ? service.service.currency ?? "" : "EUR"} /></div>
        <div class="space-y-1.5"><Label for="service-duration">{t.admin.fields.duration}</Label><Input id="service-duration" name="durationMinutes" type="number" min="1" value={service?.service.durationMinutes ?? ""} /></div>
        <div class="space-y-1.5"><Label for="service-capacity">{t.admin.fields.maxParticipants}</Label><Input id="service-capacity" name="maxParticipants" type="number" min="1" value={service?.service.maxParticipants ?? ""} /></div>
      </section>

      <section class="space-y-4 rounded-xl border p-4"><div class="flex flex-wrap gap-6"><Checkbox name="isMobile" label={t.admin.fields.mobile} checked={service?.service.isMobile ?? false} /><Checkbox name="isFeatured" label={t.admin.fields.featured} checked={service?.service.isFeatured ?? false} /></div>
        <div class="space-y-2"><Label>{t.admin.fields.categories}</Label><div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">{categoryRows.map(({ category, translation: categoryTranslation }) => <Checkbox name="categoryIds" value={category.id} label={categoryTranslation?.name ?? category.slug} checked={selectedCategoryIds.has(category.id)} />)}</div></div>
        <div class="space-y-2"><Label>{t.admin.fields.tags}</Label><div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">{tagRows.map(({ tag, translation: tagTranslation }) => <Checkbox name="tagIds" value={tag.id} label={tagTranslation?.name ?? tag.slug} checked={selectedTagIds.has(tag.id)} />)}</div></div>
      </section>

      <section class="grid gap-4 rounded-xl border p-4 md:grid-cols-2"><div class="space-y-2"><Label>{t.admin.fields.coverImage}</Label><div class="flex items-center gap-2"><Input id="service-cover-preview" value={service?.service.coverImageId ?? ""} readonly /><Button type="button" variant="outline" data-media-picker="service-cover-picker">{t.admin.fields.coverImage}</Button></div><MediaPicker id="service-cover-picker" locale={locale} organizationId={organizationId} /></div>
        <div class="space-y-2"><Label>{t.admin.fields.media}</Label><div class="flex items-center gap-2"><Input id="service-og-preview" value={translation?.ogImageId ?? ""} readonly /><Button type="button" variant="outline" data-media-picker="service-og-picker">{t.admin.fields.media}</Button></div><MediaPicker id="service-og-picker" locale={locale} organizationId={organizationId} /></div>
        <div class="space-y-1.5"><Label for="service-meta-title">{t.admin.fields.seo}</Label><Input id="service-meta-title" name="metaTitle" value={translation?.metaTitle ?? ""} /></div>
        <div class="space-y-1.5"><Label for="service-meta-description">{t.admin.fields.seo}</Label><Textarea id="service-meta-description" name="metaDescription" rows={2} defaultValue={translation?.metaDescription ?? ""} /></div>
        <div class="space-y-1.5"><Label for="service-focus-keyword">{t.admin.fields.focusKeyword}</Label><Input id="service-focus-keyword" name="focusKeyword" value={focusKeyword} /></div>
        <div class="space-y-1.5"><Label for="service-location-label">{t.admin.fields.location}</Label><Input id="service-location-label" name="locationLabel" value={translation?.locationLabel ?? ""} /></div>
        <div class="space-y-1.5 md:col-span-2"><Label for="service-location-address">{t.admin.fields.address}</Label><Input id="service-location-address" name="locationAddress" value={translation?.locationAddress ?? ""} /></div>
      </section>

      <section class="space-y-4 rounded-xl border p-4"><h2 class="font-semibold">{t.admin.fields.availability}</h2><div class="space-y-2">{service?.availability.map((slot) => <div class="grid gap-2 rounded-lg border p-3 sm:grid-cols-[auto_1fr_1fr_1fr_auto] sm:items-end"><span class="text-sm font-medium">{slot.dayOfWeek}</span><Input value={slot.startTime} readonly aria-label={t.admin.fields.availability} /><Input value={slot.endTime} readonly aria-label={t.admin.fields.availability} /><Input value={slot.timezone} readonly aria-label={t.admin.fields.availability} /><Button type="button" variant="outline" data-delete-availability={slot.id}>{t.admin.delete}</Button></div>)}</div>{service && <div class="grid gap-2 sm:grid-cols-5"><Input type="number" min="0" max="6" data-new-availability="day" placeholder="0–6" /><Input type="time" data-new-availability="start" /><Input type="time" data-new-availability="end" /><Input value="UTC" data-new-availability="timezone" /><Button type="button" data-add-availability>{t.admin.save}</Button></div>}</section>

      <section class="space-y-4 rounded-xl border p-4"><h2 class="font-semibold">{t.admin.fields.media}</h2><div class="space-y-2">{service?.media.map((media) => <div class="flex items-center justify-between gap-3 rounded-lg border p-3"><div class="min-w-0"><p class="truncate text-sm font-medium">{media.mediaId}</p><p class="text-xs text-muted-foreground">{media.altText}</p></div><Button type="button" variant="outline" data-remove-media={media.mediaId}>{t.admin.delete}</Button></div>)}</div>{service && <div class="grid gap-2 md:grid-cols-[minmax(0,1fr)_auto_auto]"><Input data-new-media="id" placeholder={t.admin.fields.media} /><Input data-new-media="alt" placeholder={t.admin.fields.title} /><Button type="button" data-add-media>{t.admin.save}</Button></div>}</section>

      {service && <section class="space-y-4 rounded-xl border p-4"><div class="flex items-center justify-between gap-3"><div><h2 class="font-semibold">{t.admin.fields.publication}</h2><p class="text-sm text-muted-foreground">{t.admin.preview}</p></div><Button type="button" variant="outline" data-load-revisions>{t.admin.restoreRevision}</Button></div><div data-revisions-container class="space-y-2" aria-live="polite"></div></section>}

      <div class="flex flex-wrap justify-end gap-3 border-t pt-5"><Button type="button" variant="outline" href={baseAdminUrl}>{t.admin.cancel}</Button><Button type="submit">{t.admin.save}</Button></div>
      <p id="service-form-status" class="text-sm" aria-live="polite"></p>
    </form>
  </div>
</AdminFormShell>
<script>
  import { actions } from "astro:actions";
  import { getServiceErrorMessage } from "@/modules/services/i18n";

  for (const root of document.querySelectorAll<HTMLElement>("[data-service-admin-root]")) {
    const labels = JSON.parse(root.dataset.actionLabels ?? "{}") as { confirmDelete: string; confirmArchive: string; actionError: string; restoreRevision: string; saved: string; lock: string; unlock: string };
    const organizationId = root.dataset.organizationId || null;
    const serviceId = root.dataset.serviceId || null;
    const baseAdminUrl = root.dataset.baseAdminUrl ?? window.location.pathname.replace(/\/[^/]+$/, "");
    const form = root.querySelector<HTMLFormElement>("form[data-service-form]");
    const status = root.querySelector<HTMLElement>("#service-form-status");

    const errorMessage = (result: { error?: { code?: string } } | null | undefined) => result?.error ? getServiceErrorMessage(document.documentElement.lang || "fr", result.error.code) : labels.actionError;

    async function lifecycle(action: "publish" | "unpublish" | "archive" | "restore" | "duplicate" | "delete") {
      if (!serviceId) return;
      if (action === "delete" && !window.confirm(labels.confirmDelete)) return;
      if (action === "archive" && !window.confirm(labels.confirmArchive)) return;
      const result = action === "publish"
        ? await actions.publishService({ id: serviceId, organizationId })
        : action === "unpublish"
          ? await actions.unpublishService({ id: serviceId, organizationId })
          : action === "archive"
            ? await actions.archiveService({ id: serviceId, organizationId })
            : action === "restore"
              ? await actions.restoreService({ id: serviceId, organizationId })
              : action === "duplicate"
                ? await actions.duplicateService({ id: serviceId, organizationId })
                : await actions.deleteService({ id: serviceId, organizationId });
      if (result.error) { if (status) status.textContent = errorMessage(result); return; }
      if (status) status.textContent = labels.saved;
      if (action === "duplicate" && result.data?.id) window.location.href = `${baseAdminUrl}/${result.data.id}/edit`; else window.location.reload();
    }

    root.querySelectorAll<HTMLButtonElement>("[data-service-lifecycle]").forEach((button) => button.addEventListener("click", () => lifecycle(button.dataset.serviceLifecycle as "publish" | "unpublish" | "archive" | "restore" | "duplicate" | "delete")));

    root.querySelectorAll<HTMLButtonElement>("[data-service-lock]").forEach((button) => button.addEventListener("click", async () => {
      if (!serviceId) return;
      const action = button.dataset.serviceLock;
      const result = action === "lock" ? await actions.lockService({ id: serviceId, organizationId }) : await actions.unlockService({ id: serviceId, organizationId });
      if (status) status.textContent = result.error ? errorMessage(result) : labels.saved;
    }));

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const checkedValues = (name: string) => Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((input) => input.value);
      const payload = {
        organizationId: String(data.get("organizationId") || "") || null,
        locale: String(data.get("locale")),
        title: String(data.get("title")), slug: String(data.get("slug")), excerpt: String(data.get("excerpt") || "") || null,
        content: String(data.get("content")), coverImageId: String(data.get("coverImageId") || "") || null, ogImageId: String(data.get("ogImageId") || "") || null,
        priceMinor: data.get("priceMinor") ? Number(data.get("priceMinor")) : null, currency: String(data.get("currency") || "") || null,
        durationMinutes: data.get("durationMinutes") ? Number(data.get("durationMinutes")) : null, maxParticipants: data.get("maxParticipants") ? Number(data.get("maxParticipants")) : null,
        isMobile: form.querySelector<HTMLInputElement>('input[name="isMobile"]')?.checked ?? false, isFeatured: form.querySelector<HTMLInputElement>('input[name="isFeatured"]')?.checked ?? false,
        categoryIds: checkedValues("categoryIds"), tagIds: checkedValues("tagIds"), metaTitle: String(data.get("metaTitle") || "") || null,
        metaDescription: String(data.get("metaDescription") || "") || null, locationLabel: String(data.get("locationLabel") || "") || null, locationAddress: String(data.get("locationAddress") || "") || null,
        focusKeyword: String(data.get("focusKeyword") || "") || null,
        ...(form.dataset.mode === "create" ? { status: "DRAFT" as const, publishedAt: null } : {}),
      };
      const result = form.dataset.mode === "edit" ? await actions.updateService({ ...payload, id: String(data.get("id")) }) : await actions.createService(payload);
      if (status) status.textContent = result.error ? errorMessage(result) : labels.saved;
      if (!result.error && result.data?.id && form.dataset.mode !== "edit") window.location.href = `${baseAdminUrl}/${result.data.id}/edit`;
    });

    root.querySelectorAll<HTMLElement>("[data-media-picker]").forEach((button) => {
      const picker = document.getElementById(button.dataset.mediaPicker ?? "");
      picker?.addEventListener("media-select", (event) => {
        const detail = (event as CustomEvent).detail as { fileId: string };
        if (button.dataset.mediaPicker === "service-cover-picker") { const input = form?.querySelector<HTMLInputElement>('input[name="coverImageId"]'); const preview = form?.querySelector<HTMLInputElement>("#service-cover-preview"); if (input) input.value = detail.fileId; if (preview) preview.value = detail.fileId; }
        if (button.dataset.mediaPicker === "service-og-picker") { const input = form?.querySelector<HTMLInputElement>('input[name="ogImageId"]'); const preview = form?.querySelector<HTMLInputElement>("#service-og-preview"); if (input) input.value = detail.fileId; if (preview) preview.value = detail.fileId; }
      });
    });

    root.querySelector<HTMLButtonElement>("[data-add-availability]")?.addEventListener("click", async () => {
      if (!serviceId) return;
      const result = await actions.createServiceAvailability({ serviceId, organizationId, dayOfWeek: Number(root.querySelector<HTMLInputElement>('[data-new-availability="day"]')?.value), startTime: root.querySelector<HTMLInputElement>('[data-new-availability="start"]')?.value ?? "", endTime: root.querySelector<HTMLInputElement>('[data-new-availability="end"]')?.value ?? "", timezone: root.querySelector<HTMLInputElement>('[data-new-availability="timezone"]')?.value ?? "UTC" });
      if (status) status.textContent = result.error ? errorMessage(result) : labels.saved; if (!result.error) window.location.reload();
    });

    root.querySelectorAll<HTMLButtonElement>("[data-delete-availability]").forEach((button) => button.addEventListener("click", async () => {
      if (!serviceId || !window.confirm(labels.confirmDelete)) return;
      const result = await actions.deleteServiceAvailability({ id: button.dataset.deleteAvailability ?? "", serviceId, organizationId });
      if (status) status.textContent = result.error ? errorMessage(result) : labels.saved; if (!result.error) window.location.reload();
    }));

    root.querySelector<HTMLButtonElement>("[data-add-media]")?.addEventListener("click", async () => {
      if (!serviceId) return;
      const result = await actions.addServiceMedia({ serviceId, organizationId, mediaId: root.querySelector<HTMLInputElement>('[data-new-media="id"]')?.value ?? "", altText: root.querySelector<HTMLInputElement>('[data-new-media="alt"]')?.value ?? "", kind: "GALLERY", sortOrder: 0 });
      if (status) status.textContent = result.error ? errorMessage(result) : labels.saved; if (!result.error) window.location.reload();
    });

    root.querySelectorAll<HTMLButtonElement>("[data-remove-media]").forEach((button) => button.addEventListener("click", async () => {
      if (!serviceId || !window.confirm(labels.confirmDelete)) return;
      const result = await actions.removeServiceMedia({ serviceId, organizationId, mediaId: button.dataset.removeMedia ?? "" });
      if (status) status.textContent = result.error ? errorMessage(result) : labels.saved; if (!result.error) window.location.reload();
    }));

    root.querySelector<HTMLButtonElement>("[data-load-revisions]")?.addEventListener("click", async () => {
      if (!serviceId) return;
      const result = await actions.listServiceRevisions({ id: serviceId, organizationId });
      const container = root.querySelector<HTMLElement>("[data-revisions-container]");
      if (!container) return;
      if (result.error) { container.textContent = errorMessage(result); return; }
      container.innerHTML = (result.data ?? []).map((revision) => `<div class="flex items-center justify-between gap-2 rounded-lg border p-3"><div><p class="text-sm font-medium">${revision.title}</p><p class="text-xs text-muted-foreground">${revision.status} · ${new Date(revision.createdAt).toLocaleString()}</p></div><button type="button" class="restore-revision rounded-md border px-2 py-1 text-xs" data-revision-id="${revision.id}">${labels.restoreRevision}</button></div>`).join("");
      container.querySelectorAll<HTMLButtonElement>(".restore-revision").forEach((button) => button.addEventListener("click", async () => { const restore = await actions.restoreServiceRevision({ revisionId: button.dataset.revisionId ?? "", serviceId, organizationId }); if (status) status.textContent = restore.error ? errorMessage(restore) : labels.saved; if (!restore.error) window.location.reload(); }));
    });
  }
</script>
