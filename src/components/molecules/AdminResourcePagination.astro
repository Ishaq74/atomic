---
import { Pagination, PaginationContent, PaginationItem, PaginationLink, PaginationNext, PaginationPrevious } from "@atoms/pagination";

interface Props {
  page: number;
  totalPages: number;
  hasNextPage: boolean;
  hasPrevPage: boolean;
}
const { page, totalPages, hasNextPage, hasPrevPage } = Astro.props;
const pageTokens: Array<number | null> = [];
for (let i = 1; i <= totalPages; i += 1) {
  if (i === 1 || i === totalPages || (i >= page - 1 && i <= page + 1)) pageTokens.push(i);
  else if (pageTokens[pageTokens.length - 1] !== null) pageTokens.push(null);
}
function pageUrl(target: number): string {
  const url = new URL(Astro.url.href);
  if (target === 1) url.searchParams.delete("page");
  else url.searchParams.set("page", String(target));
  return url.pathname + url.search;
}
---
{totalPages > 1 && (
  <Pagination class="mt-6">
    <PaginationContent>
      {hasPrevPage && <PaginationItem><PaginationPrevious href={pageUrl(page - 1)} /></PaginationItem>}
      {pageTokens.map((token) => token === null
        ? <PaginationItem><span class="px-2 text-muted-foreground">…</span></PaginationItem>
        : <PaginationItem><PaginationLink href={pageUrl(token)} isActive={token === page} aria-current={token === page ? "page" : undefined}>{token}</PaginationLink></PaginationItem>
      )}
      {hasNextPage && <PaginationItem><PaginationNext href={pageUrl(page + 1)} /></PaginationItem>}
    </PaginationContent>
  </Pagination>
)}
