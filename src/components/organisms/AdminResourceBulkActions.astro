---
interface BulkAction {
  id: string;
  label: string;
  destructive?: boolean;
}

interface Props {
  resourceId: string;
  actions: readonly BulkAction[];
  selectedCount: number;
  selectionLabel: string;
}

const { resourceId, actions, selectedCount, selectionLabel } = Astro.props;
---
<div
  data-admin-resource-bulk-actions={resourceId}
  class:list={["flex flex-wrap items-center gap-2 rounded-lg border p-3", selectedCount === 0 && "hidden"]}
  aria-live="polite"
>
  <span class="mr-auto text-sm text-muted-foreground" data-selected-count>
    {selectedCount} {selectionLabel}
  </span>
  {actions.map((action) => (
    <button
      type="button"
      class:list={["rounded-md border px-3 py-1.5 text-sm", action.destructive && "text-destructive"]}
      data-bulk-action={action.id}
      disabled={selectedCount === 0}
    >
      {action.label}
    </button>
  ))}
</div>
