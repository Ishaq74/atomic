---
import { getRelativeLocaleUrl } from "astro:i18n";
import { LOCALES, LOCALE_LABELS, type Locale } from "@i18n/config";
import type { BlogTranslations } from "@i18n/config";
import { Card, CardContent, CardHeader, CardTitle } from "@atoms/card";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@atoms/tabs";
import AdminPostList from "./AdminPostList.astro";
import AdminTaxonomyManager from "./AdminTaxonomyManager.astro";
import AdminModerationQueue from "./AdminModerationQueue.astro";
import NotificationBell from "./NotificationBell.astro";

interface PostRow {
  post: {
    id: string;
    status: string;
    viewCount: number;
    seoScore: number | null;
  };
  translation: { title: string; slug: string } | null;
  author: { id: string; name: string | null } | null;
  categories: { id: string; slug: string; name: string | null }[];
}

interface TaxonomyItem {
  id: string;
  slug: string;
  name: string;
  description?: string | null;
  color?: string | null;
  icon?: string | null;
  parentId?: string | null;
  sortOrder?: number | null;
  postCount: number;
}

interface Props {
  locale: Locale;
  blogT: BlogTranslations;
  title: string;
  posts: PostRow[];
  postsMeta: {
    total: number;
    page: number;
    limit: number;
    totalPages: number;
    hasNextPage: boolean;
    hasPrevPage: boolean;
  };
  categories: TaxonomyItem[];
  tags: TaxonomyItem[];
  moderation: {
    comments: { comment: { id: string; content: string; createdAt: Date; guestName: string | null; guestEmail: string | null; status: string }; post: { id: string; slug: string } }[];
    reviews: { review: { id: string; rating: number; title: string | null; content: string; createdAt: Date; status: string }; post: { id: string; slug: string } }[];
    reports: { report: { id: string; reason: string; description: string | null; createdAt: Date; status: string }; post: { id: string; slug: string } | null }[];
  };
  baseAdminUrl: string;
  basePublicUrl: string;
  organizationId?: string | null;
  userId: string;
  canPublish: boolean;
  canDelete: boolean;
}

const {
  title,
  locale,
  blogT,
  posts,
  postsMeta,
  categories,
  tags,
  moderation,
  baseAdminUrl,
  basePublicUrl,
  organizationId,
  userId,
  canPublish,
  canDelete,
} = Astro.props;

const publishedCount = posts.filter((row) => row.post.status === "PUBLISHED").length;
const draftCount = posts.filter((row) => row.post.status === "DRAFT").length;
const moderationCount = moderation.comments.length + moderation.reviews.length + moderation.reports.length;
const localeSwitcherT = blogT.admin.localeSwitcher ?? {
  title: "Languages",
  available: "Available",
  missing: "Missing",
};
const currentPath = Astro.url.pathname;
const pathWithoutLocale = currentPath.replace(new RegExp(`^/${locale}(?=/|$)`), '') || '/';

function buildLocaleHref(targetLocale: Locale): string {
  return `${getRelativeLocaleUrl(targetLocale, pathWithoutLocale)}${Astro.url.search}`;
}
---

<div class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="font-heading text-2xl font-semibold">{title}</h1>
      <p class="mt-1 text-sm text-muted-foreground">{blogT.admin.title}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{localeSwitcherT.title}</span>
        {LOCALES.map((loc) => (
          <a
            href={buildLocaleHref(loc)}
            class:list={[
              'inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium transition-colors',
              {"border-primary bg-primary text-primary-foreground": loc === locale, "border-border bg-background text-muted-foreground hover:border-primary/40 hover:text-foreground": loc !== locale},
            ]}
          >
            {LOCALE_LABELS[loc]}
          </a>
        ))}
      </div>
    </div>
    <NotificationBell
      blogT={blogT}
      userId={userId}
      baseAdminUrl={baseAdminUrl}
      organizationId={organizationId ?? null}
    />
  </div>

  <Tabs defaultValue="posts">
    <TabsList>
      <TabsTrigger value="posts" defaultActive>{blogT.admin.posts}</TabsTrigger>
      <TabsTrigger value="categories">{blogT.admin.categories}</TabsTrigger>
      <TabsTrigger value="tags">{blogT.admin.tags}</TabsTrigger>
      <TabsTrigger value="moderation">{blogT.admin.moderation}</TabsTrigger>
      <TabsTrigger value="stats">{blogT.admin.stats}</TabsTrigger>
    </TabsList>

    <TabsContent value="posts" defaultActive class="pt-4">
      <AdminPostList
        locale={locale}
        blogT={blogT}
        rows={posts as never}
        meta={postsMeta}
        baseAdminUrl={baseAdminUrl}
        basePublicUrl={basePublicUrl}
        canPublish={canPublish}
        canDelete={canDelete}
        organizationId={organizationId}
      />
    </TabsContent>

    <TabsContent value="categories" class="pt-4">
      <AdminTaxonomyManager
        locale={locale}
        blogT={blogT}
        kind="category"
        items={categories}
        organizationId={organizationId}
      />
    </TabsContent>

    <TabsContent value="tags" class="pt-4">
      <AdminTaxonomyManager
        locale={locale}
        blogT={blogT}
        kind="tag"
        items={tags}
        organizationId={organizationId}
      />
    </TabsContent>

    <TabsContent value="moderation" class="pt-4">
      <AdminModerationQueue blogT={blogT} moderation={moderation} organizationId={organizationId} />
    </TabsContent>

    <TabsContent value="stats" class="pt-4">
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <Card>
          <CardHeader><CardTitle class="text-sm text-muted-foreground">{blogT.admin.posts}</CardTitle></CardHeader>
          <CardContent><p class="text-3xl font-bold">{postsMeta.total}</p></CardContent>
        </Card>
        <Card>
          <CardHeader><CardTitle class="text-sm text-muted-foreground">{blogT.statuses.PUBLISHED}</CardTitle></CardHeader>
          <CardContent><p class="text-3xl font-bold">{publishedCount}</p></CardContent>
        </Card>
        <Card>
          <CardHeader><CardTitle class="text-sm text-muted-foreground">{blogT.statuses.DRAFT}</CardTitle></CardHeader>
          <CardContent><p class="text-3xl font-bold">{draftCount}</p></CardContent>
        </Card>
        <Card>
          <CardHeader><CardTitle class="text-sm text-muted-foreground">{blogT.admin.moderation}</CardTitle></CardHeader>
          <CardContent><p class="text-3xl font-bold">{moderationCount}</p></CardContent>
        </Card>
      </div>
    </TabsContent>
  </Tabs>
</div>